rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isPasswordProvider() {
      return isSignedIn() &&
        ('firebase' in request.auth.token) &&
        request.auth.token.firebase is map &&
        ('sign_in_provider' in request.auth.token.firebase) &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isGoogleVerifiedEmail() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email.size() >= 3 &&
        request.auth.token.email.size() <= 160;
    }

    function hasAccountEmailToken() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email.size() >= 3 &&
        request.auth.token.email.size() <= 160;
    }

    function isBootstrappedAdmin() {
      return isGoogleVerifiedEmail() && request.auth.token.email.lower() == 'control.mogma@gmail.com';
    }

    function accountDocId() {
      return request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_');
    }

    function hasVerifiedGoogleAccount() {
      return isGoogleVerifiedEmail() && exists(/databases/$(database)/documents/accounts/$(accountDocId()));
    }

    function myAccount() {
      return get(/databases/$(database)/documents/accounts/$(accountDocId())).data;
    }

    function isProvisionedPasswordAcctData(acc) {
      return ('authType' in acc) &&
        ('authUid' in acc) &&
        acc.authType == 'credentials' &&
        acc.authUid == request.auth.uid;
    }

    function hasProvisionedPasswordAccount() {
      let accPath = /databases/$(database)/documents/accounts/$(accountDocId());
      return isPasswordProvider() &&
        hasAccountEmailToken() &&
        exists(accPath) &&
        isProvisionedPasswordAcctData(get(accPath).data);
    }

    function hasAccountDoc() {
      return hasVerifiedGoogleAccount() || hasProvisionedPasswordAccount();
    }

    function hasActiveAccountDoc() {
      return hasAccountDoc() &&
        ('status' in myAccount()) &&
        myAccount().status == 'active' &&
        ('role' in myAccount()) &&
        myAccount().role in ['admin', 'branch_supervisor', 'coordinator', 'viewer'];
    }

    function isStrictAccountAccessEnabled() {
      let sPath = /databases/$(database)/documents/settings/system;
      return exists(sPath) &&
        ('strictAccountAccess' in get(sPath).data) &&
        get(sPath).data.strictAccountAccess == true;
    }

    function isVerified() {
      return isGoogleVerifiedEmail() || (hasProvisionedPasswordAccount() && myAccount().status == 'active');
    }

    function isSuspendedAccount() {
      return hasAccountDoc() && ('status' in myAccount()) && myAccount().status == 'suspended';
    }

    function isViewerOnly() {
      return hasAccountDoc() &&
        ('status' in myAccount()) &&
        myAccount().status == 'active' &&
        ('role' in myAccount()) &&
        myAccount().role == 'viewer';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isGoogleVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        (hasActiveAccountDoc() && myAccount().role == 'admin');
    }

    function hasPermission(perm) {
      return isAdmin() || (
        hasActiveAccountDoc() &&
        myAccount().role == 'branch_supervisor' &&
        ('permissions' in myAccount()) &&
        myAccount().permissions is map &&
        (perm in myAccount().permissions) &&
        myAccount().permissions[perm] == true
      );
    }

    function canWriteBookingsByAccountRole() {
      return isAdmin() ||
        (hasActiveAccountDoc() &&
          myAccount().role in ['admin', 'branch_supervisor', 'coordinator']) ||
        (!hasAccountDoc() &&
          isGoogleVerifiedEmail() &&
          !isStrictAccountAccessEnabled());
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCoordinatorForOwnDepartment(dept) {
      return !hasAccountDoc() ||
        !('role' in myAccount()) ||
        myAccount().role != 'coordinator' ||
        (('branchName' in myAccount()) &&
          (myAccount().branchName is string) &&
          myAccount().branchName.trim().size() >= 2 &&
          (dept == myAccount().branchName ||
            dept.trim() == myAccount().branchName.trim()));
    }

    function isValidClassroomRef(roomId) {
      let roomPath = /databases/$(database)/documents/classrooms/$(roomId);
      return exists(roomPath) && get(roomPath).data.id == roomId;
    }

    function lookupAcctPath() {
      return /databases/$(database)/documents/accounts/$(accountDocId());
    }

    function hasValidAccountAuthAndActiveStatus(acc) {
      let isActive = ('status' in acc) && acc.status == 'active';
      let isPwdOk = !isPasswordProvider() || isProvisionedPasswordAcctData(acc);
      return isActive && isPwdOk;
    }

    function acctMatchesDepartment(acc, dept) {
      return !('role' in acc) ||
        acc.role != 'coordinator' ||
        (('branchName' in acc) &&
          (acc.branchName is string) &&
          acc.branchName.trim().size() >= 2 &&
          (dept == acc.branchName || dept.trim() == acc.branchName.trim()));
    }

    function acctHasPerm(acc, perm) {
      return ('role' in acc) && (
        acc.role == 'admin' ||
        (acc.role == 'branch_supervisor' &&
          ('permissions' in acc) &&
          acc.permissions is map &&
          (perm in acc.permissions) &&
          acc.permissions[perm] == true)
      );
    }

    function canAcctCreateBooking(acc, data, isTrustedAdmin) {
      let activeAndAuthOk = hasValidAccountAuthAndActiveStatus(acc);
      let roleOk = isTrustedAdmin || (('role' in acc) && acc.role in ['admin', 'branch_supervisor', 'coordinator']);
      let deptOk = isTrustedAdmin || acctMatchesDepartment(acc, data.department);
      let statusOk = data.status == 'pending' || isTrustedAdmin || acctHasPerm(acc, 'approveBookings');
      return activeAndAuthOk && roleOk && deptOk && statusOk;
    }

    function canCreateBookingWithLookup(accPath, data, isTrustedAdmin) {
      let hasAcct = exists(accPath);
      return (hasAcct && canAcctCreateBooking(get(accPath).data, data, isTrustedAdmin)) ||
        (!hasAcct && isTrustedAdmin) ||
        (!hasAcct && isGoogleVerifiedEmail() && !isStrictAccountAccessEnabled() && data.status == 'pending');
    }

    function canCreateBookingGate(data) {
      let canLookupAcct = isGoogleVerifiedEmail() || (isPasswordProvider() && hasAccountEmailToken());
      let isTrustedAdmin = isBootstrappedAdmin() ||
        (isGoogleVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      return isValidClassroomRef(data.roomId) && (
        (canLookupAcct && canCreateBookingWithLookup(lookupAcctPath(), data, isTrustedAdmin)) ||
        (!canLookupAcct && isTrustedAdmin)
      );
    }

    function canAcctUpdateBooking(acc, data, prev, isTrustedAdmin) {
      let activeAndAuthOk = hasValidAccountAuthAndActiveStatus(acc);
      let roleOk = isTrustedAdmin || (('role' in acc) && acc.role in ['admin', 'branch_supervisor', 'coordinator']);
      let canApprove = isTrustedAdmin || acctHasPerm(acc, 'approveBookings');
      let canManage = isTrustedAdmin || acctHasPerm(acc, 'manageBookings');
      let changedKeys = data.diff(prev).affectedKeys();
      let actionApprove = canApprove &&
        changedKeys.hasOnly([
          'roomId', 'roomName', 'courseTitle', 'instructorName', 'department',
          'bookingType', 'date', 'startTime', 'endTime', 'attendeesCount',
          'status', 'notes', 'updatedAt'
        ]) &&
        isValidClassroomRef(data.roomId);
      let actionManage = canManage &&
        (data.status == prev.status || data.status == 'cancelled') &&
        changedKeys.hasOnly([
          'roomId', 'roomName', 'courseTitle', 'instructorName', 'department',
          'bookingType', 'date', 'startTime', 'endTime', 'attendeesCount',
          'status', 'notes', 'updatedAt'
        ]) &&
        isValidClassroomRef(data.roomId);
      let actionOwnerEdit = prev.creatorId == request.auth.uid &&
        prev.status == 'pending' &&
        data.status == prev.status &&
        acctMatchesDepartment(acc, data.department) &&
        changedKeys.hasOnly([
          'roomId', 'roomName', 'courseTitle', 'instructorName', 'department',
          'bookingType', 'date', 'startTime', 'endTime', 'attendeesCount',
          'notes', 'updatedAt'
        ]) &&
        isValidClassroomRef(data.roomId);
      let actionOwnerCancel = prev.creatorId == request.auth.uid &&
        prev.status in ['pending', 'confirmed'] &&
        data.status == 'cancelled' &&
        changedKeys.hasOnly(['status', 'updatedAt']);
      return activeAndAuthOk && roleOk && (actionApprove || actionManage || actionOwnerEdit || actionOwnerCancel);
    }

    function canNoAcctUpdateBooking(data, prev, isTrustedAdmin) {
      let changedKeys = data.diff(prev).affectedKeys();
      let adminUpdate = isTrustedAdmin &&
        changedKeys.hasOnly([
          'roomId', 'roomName', 'courseTitle', 'instructorName', 'department',
          'bookingType', 'date', 'startTime', 'endTime', 'attendeesCount',
          'status', 'notes', 'updatedAt'
        ]) &&
        isValidClassroomRef(data.roomId);
      let ownerEdit = !isStrictAccountAccessEnabled() &&
        prev.creatorId == request.auth.uid &&
        prev.status == 'pending' &&
        data.status == prev.status &&
        changedKeys.hasOnly([
          'roomId', 'roomName', 'courseTitle', 'instructorName', 'department',
          'bookingType', 'date', 'startTime', 'endTime', 'attendeesCount',
          'notes', 'updatedAt'
        ]) &&
        isValidClassroomRef(data.roomId);
      let ownerCancel = !isStrictAccountAccessEnabled() &&
        prev.creatorId == request.auth.uid &&
        prev.status in ['pending', 'confirmed'] &&
        data.status == 'cancelled' &&
        changedKeys.hasOnly(['status', 'updatedAt']);
      return adminUpdate || ownerEdit || ownerCancel;
    }

    function canUpdateBookingWithLookup(accPath, data, prev, isTrustedAdmin) {
      let hasAcct = exists(accPath);
      return (hasAcct && canAcctUpdateBooking(get(accPath).data, data, prev, isTrustedAdmin)) ||
        (!hasAcct && isGoogleVerifiedEmail() && canNoAcctUpdateBooking(data, prev, isTrustedAdmin));
    }

    function canUpdateBookingGate(data, prev) {
      let canLookupAcct = isGoogleVerifiedEmail() || (isPasswordProvider() && hasAccountEmailToken());
      let isTrustedAdmin = isBootstrappedAdmin() ||
        (isGoogleVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      return (canLookupAcct && canUpdateBookingWithLookup(lookupAcctPath(), data, prev, isTrustedAdmin)) ||
        (!canLookupAcct && isTrustedAdmin && canNoAcctUpdateBooking(data, prev, isTrustedAdmin));
    }

    function canAcctDeleteBooking(acc, prev, isTrustedAdmin) {
      let activeAndAuthOk = hasValidAccountAuthAndActiveStatus(acc);
      let roleOk = isTrustedAdmin || (('role' in acc) && acc.role in ['admin', 'branch_supervisor', 'coordinator']);
      let allowedByPermOrOwner = isTrustedAdmin ||
        acctHasPerm(acc, 'approveBookings') ||
        acctHasPerm(acc, 'manageBookings') ||
        (prev.creatorId == request.auth.uid && prev.status == 'pending');
      return activeAndAuthOk && roleOk && allowedByPermOrOwner;
    }

    function canDeleteBookingWithLookup(accPath, prev, isTrustedAdmin) {
      let hasAcct = exists(accPath);
      return (hasAcct && canAcctDeleteBooking(get(accPath).data, prev, isTrustedAdmin)) ||
        (!hasAcct && isGoogleVerifiedEmail() && (
          isTrustedAdmin ||
          (!isStrictAccountAccessEnabled() && prev.creatorId == request.auth.uid && prev.status == 'pending')
        ));
    }

    function canDeleteBookingGate(prev) {
      let canLookupAcct = isGoogleVerifiedEmail() || (isPasswordProvider() && hasAccountEmailToken());
      let isTrustedAdmin = isBootstrappedAdmin() ||
        (isGoogleVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      return (canLookupAcct && canDeleteBookingWithLookup(lookupAcctPath(), prev, isTrustedAdmin)) ||
        (!canLookupAcct && isTrustedAdmin);
    }

    function canAcctWriteAuditLog(acc) {
      return hasValidAccountAuthAndActiveStatus(acc) &&
        (!('role' in acc) || acc.role != 'viewer');
    }

    function canWriteAuditLogWithLookup(accPath) {
      let hasAcct = exists(accPath);
      return (hasAcct && canAcctWriteAuditLog(get(accPath).data)) ||
        (!hasAcct && isGoogleVerifiedEmail());
    }

    function canWriteAuditLogGate() {
      let canLookupAcct = isGoogleVerifiedEmail() || (isPasswordProvider() && hasAccountEmailToken());
      return canLookupAcct && canWriteAuditLogWithLookup(lookupAcctPath());
    }

    // --- Entity Validation Blueprints (No existing() or diff() inside) ---
    function isValidClassroom(data) {
      return data.keys().hasAll([
        'id', 'name', 'code', 'floor', 'capacity', 'equipment',
        'status', 'imageUrl', 'notes', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'name', 'code', 'floor', 'capacity', 'equipment',
        'status', 'imageUrl', 'notes', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
      data.code is string && data.code.size() >= 2 && data.code.size() <= 24 &&
      data.floor is string && data.floor.size() >= 1 && data.floor.size() <= 40 &&
      data.capacity is int && data.capacity >= 1 && data.capacity <= 500 &&
      data.equipment is list && data.equipment.size() >= 1 && data.equipment.size() <= 10 &&
      data.equipment[0] is string && data.equipment[0].size() >= 1 && data.equipment[0].size() <= 60 &&
      data.status in ['available', 'maintenance'] &&
      data.imageUrl is string && data.imageUrl.size() <= 300 &&
      data.notes is string && data.notes.size() <= 300 &&
      data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
        'id', 'roomId', 'roomName', 'courseTitle', 'instructorName',
        'department', 'bookingType', 'date', 'startTime', 'endTime',
        'attendeesCount', 'status', 'notes', 'creatorId', 'creatorName',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'roomId', 'roomName', 'courseTitle', 'instructorName',
        'department', 'bookingType', 'date', 'startTime', 'endTime',
        'attendeesCount', 'status', 'notes', 'creatorId', 'creatorName',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.roomId) &&
      data.roomName is string && data.roomName.trim().size() >= 2 && data.roomName.size() <= 100 &&
      data.courseTitle is string && data.courseTitle.trim().size() >= 2 && data.courseTitle.size() <= 120 &&
      data.instructorName is string && data.instructorName.trim().size() >= 2 && data.instructorName.size() <= 80 &&
      data.department is string && data.department.trim().size() >= 2 && data.department.size() <= 80 &&
      data.bookingType in ['lecture', 'workshop', 'exam', 'seminar'] &&
      data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
      data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$') &&
      data.endTime is string && data.endTime.size() == 5 && data.endTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$') &&
      data.startTime < data.endTime &&
      data.attendeesCount is int && data.attendeesCount >= 1 && data.attendeesCount <= 500 &&
      data.status in ['pending', 'confirmed', 'rejected', 'cancelled'] &&
      data.notes is string && data.notes.size() <= 300 &&
      data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
      data.creatorName is string && data.creatorName.trim().size() >= 1 && data.creatorName.size() <= 80 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'photoURL', 'department', 'role', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'email', 'displayName', 'photoURL', 'department', 'role', 'createdAt', 'updatedAt'
      ]) &&
      data.uid == userId &&
      data.email is string && data.email.size() <= 160 &&
      data.displayName is string && data.displayName.size() <= 80 &&
      data.photoURL is string && data.photoURL.size() <= 300 &&
      data.department is string && data.department.size() <= 80 &&
      data.role in ['admin', 'branch_supervisor', 'coordinator', 'viewer'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminId) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt']) &&
      data.keys().hasOnly(['uid', 'grantedBy', 'createdAt']) &&
      data.uid == adminId &&
      data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 &&
      data.createdAt is timestamp;
    }

    function isValidDepartment(data) {
      return data.keys().hasAll([
        'id', 'name', 'code', 'headName', 'sector', 'status', 'notes', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'name', 'code', 'headName', 'sector', 'status', 'notes', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.code is string && data.code.size() >= 2 && data.code.size() <= 24 &&
      data.headName is string && data.headName.size() <= 80 &&
      data.sector is string && data.sector.size() <= 80 &&
      data.status in ['active', 'inactive'] &&
      data.notes is string && data.notes.size() <= 300 &&
      data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPermissions(perms) {
      return perms is map &&
        perms.keys().hasAll([
          'approveBookings', 'manageBookings', 'manageClassrooms',
          'manageDepartments', 'viewReports', 'manageSettings'
        ]) &&
        perms.keys().hasOnly([
          'approveBookings', 'manageBookings', 'manageClassrooms',
          'manageDepartments', 'viewReports', 'manageSettings'
        ]) &&
        perms.approveBookings is bool &&
        perms.manageBookings is bool &&
        perms.manageClassrooms is bool &&
        perms.manageDepartments is bool &&
        perms.viewReports is bool &&
        perms.manageSettings is bool;
    }

    function isValidAccount(data) {
      return data.keys().hasAll([
        'id', 'email', 'displayName', 'branchName', 'role',
        'status', 'permissions', 'notes', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'email', 'username', 'authType', 'authUid',
        'displayName', 'branchName', 'role',
        'status', 'permissions', 'notes', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
      (!('username' in data) || (data.username is string && data.username.size() <= 64)) &&
      (!('authType' in data) || data.authType in ['google', 'credentials']) &&
      (!('authUid' in data) || (data.authUid is string && data.authUid.size() <= 128)) &&
      data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80 &&
      data.branchName is string && data.branchName.size() >= 1 && data.branchName.size() <= 80 &&
      data.role in ['admin', 'branch_supervisor', 'coordinator', 'viewer'] &&
      data.status in ['active', 'suspended'] &&
      isValidPermissions(data.permissions) &&
      data.notes is string && data.notes.size() <= 300 &&
      data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSystemSettings(data) {
      return data.keys().hasAll([
        'id', 'organizationName', 'complexSubtitle', 'workStartHour', 'workEndHour',
        'maxAdvanceDays', 'requireAdminApproval', 'allowWeekendBookings',
        'strictAccountAccess', 'reportHeaderTitle', 'reportFooterNote',
        'lastBackupAt', 'lastBackupBy', 'updatedBy', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'organizationName', 'complexSubtitle', 'workStartHour', 'workEndHour',
        'maxAdvanceDays', 'requireAdminApproval', 'allowWeekendBookings',
        'strictAccountAccess', 'reportHeaderTitle', 'reportFooterNote',
        'lastBackupAt', 'lastBackupBy', 'updatedBy', 'updatedAt'
      ]) &&
      data.id == 'system' &&
      data.organizationName is string && data.organizationName.size() >= 2 && data.organizationName.size() <= 100 &&
      data.complexSubtitle is string && data.complexSubtitle.size() >= 2 && data.complexSubtitle.size() <= 120 &&
      data.workStartHour is string && data.workStartHour.size() == 5 && data.workStartHour.matches('^([01]\\d|2[0-3]):[0-5]\\d$') &&
      data.workEndHour is string && data.workEndHour.size() == 5 && data.workEndHour.matches('^([01]\\d|2[0-3]):[0-5]\\d$') &&
      data.workStartHour < data.workEndHour &&
      data.maxAdvanceDays is int && data.maxAdvanceDays >= 1 && data.maxAdvanceDays <= 365 &&
      data.requireAdminApproval is bool &&
      data.allowWeekendBookings is bool &&
      data.strictAccountAccess is bool &&
      data.reportHeaderTitle is string && data.reportHeaderTitle.size() >= 2 && data.reportHeaderTitle.size() <= 140 &&
      data.reportFooterNote is string && data.reportFooterNote.size() <= 200 &&
      data.lastBackupAt is string && data.lastBackupAt.size() <= 64 &&
      data.lastBackupBy is string && data.lastBackupBy.size() <= 80 &&
      data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
      data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
        'id', 'entityType', 'entityId', 'entityLabel', 'action',
        'summary', 'actorUid', 'actorName', 'actorRole', 'branchName', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'entityType', 'entityId', 'entityLabel', 'action',
        'summary', 'actorUid', 'actorName', 'actorRole', 'branchName', 'createdAt'
      ]) &&
      isValidId(data.id) &&
      data.entityType in ['booking', 'classroom', 'department', 'account', 'settings'] &&
      isValidId(data.entityId) &&
      data.entityLabel is string && data.entityLabel.size() >= 1 && data.entityLabel.size() <= 140 &&
      data.action in ['create', 'update', 'approve', 'reject', 'cancel', 'delete', 'restore'] &&
      data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 240 &&
      data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
      data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80 &&
      data.actorRole in ['admin', 'branch_supervisor', 'coordinator', 'viewer'] &&
      data.branchName is string && data.branchName.size() <= 80 &&
      data.createdAt is timestamp;
    }

    // --- Collection: Classrooms ---
    match /classrooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.status in ['available', 'maintenance']);

      allow create: if isSignedIn() &&
        isValidId(roomId) &&
        isValidClassroom(incoming()) &&
        incoming().id == roomId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isVerified() &&
        hasPermission('manageClassrooms');

      allow update: if isSignedIn() &&
        isValidId(roomId) &&
        isValidClassroom(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isVerified() &&
        hasPermission('manageClassrooms') &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'code', 'floor', 'capacity', 'equipment', 'status', 'imageUrl', 'notes', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(roomId) && isVerified() && hasPermission('manageClassrooms');
    }

    // --- Collection: Bookings ---
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId);
      allow list: if isSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.creatorId == request.auth.uid ||
        resource.data.status in ['confirmed', 'pending']
      );

      allow create: if isSignedIn() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().id == bookingId &&
        incoming().creatorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        canCreateBookingGate(incoming());

      allow update: if isSignedIn() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().id == existing().id &&
        incoming().creatorId == existing().creatorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        canUpdateBookingGate(incoming(), existing());

      allow delete: if isSignedIn() &&
        isValidId(bookingId) &&
        canDeleteBookingGate(existing());
    }

    // --- Collection: Isolated User Private Info ---
    match /users/{userId}/private/{docId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) && docId == 'info' && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidId(docId) &&
        docId == 'info' &&
        isOwner(userId) &&
        isValidUserPrivate(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isVerified() &&
        (isAdmin() || incoming().role == 'coordinator');

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidId(docId) &&
        docId == 'info' &&
        isValidUserPrivate(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isVerified() && (
          // Action 1: Owner updates profile details without changing role
          (isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'email', 'photoURL', 'department', 'updatedAt'
            ])) ||
          // Action 2: Admin updates user role or department
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'role', 'department', 'updatedAt'
            ]))
        );

      allow delete: if isSignedIn() && isValidId(userId) && isValidId(docId) && docId == 'info' && isVerified() && isAdmin();
    }

    // --- Collection: Trusted Admins ---
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isSignedIn() &&
        isValidId(adminId) &&
        isValidAdminRecord(incoming(), adminId) &&
        incoming().grantedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        isVerified() &&
        isAdmin();

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(adminId) && isVerified() && isAdmin();
    }

    // --- Collection: Departments ---
    match /departments/{departmentId} {
      allow get: if isSignedIn() && isValidId(departmentId);
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.status in ['active', 'inactive']);

      allow create: if isSignedIn() &&
        isValidId(departmentId) &&
        isValidDepartment(incoming()) &&
        incoming().id == departmentId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isVerified() &&
        hasPermission('manageDepartments');

      allow update: if isSignedIn() &&
        isValidId(departmentId) &&
        isValidDepartment(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isVerified() &&
        hasPermission('manageDepartments') &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'code', 'headName', 'sector', 'status', 'notes', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(departmentId) && isVerified() && hasPermission('manageDepartments');
    }

    // --- Collection: Branch & Staff Accounts ---
    match /accounts/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && (
        isBootstrappedAdmin() ||
        (isGoogleVerifiedEmail() && accountId == accountDocId()) ||
        (isPasswordProvider() &&
          hasAccountEmailToken() &&
          accountId == accountDocId() &&
          resource != null &&
          ('authType' in existing()) &&
          ('authUid' in existing()) &&
          existing().authType == 'credentials' &&
          existing().authUid == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        isBootstrappedAdmin() ||
        (isGoogleVerifiedEmail() && resource.data.email == request.auth.token.email.lower()) ||
        (isPasswordProvider() &&
          hasAccountEmailToken() &&
          resource.data.email == request.auth.token.email.lower() &&
          resource.data.authUid == request.auth.uid)
      );

      allow create: if isSignedIn() &&
        isValidId(accountId) &&
        isValidAccount(incoming()) &&
        incoming().id == accountId &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isVerified() &&
        isAdmin();

      allow update: if isSignedIn() &&
        isValidId(accountId) &&
        isValidAccount(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isVerified() &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'username', 'authType', 'authUid', 'displayName', 'branchName',
          'role', 'status', 'permissions', 'notes', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(accountId) && isVerified() && isAdmin();
    }

    // --- Collection: System Settings ---
    match /settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId) && settingId == 'system';
      allow list: if false;

      allow create: if isSignedIn() &&
        isValidId(settingId) &&
        settingId == 'system' &&
        isValidSystemSettings(incoming()) &&
        incoming().id == settingId &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isVerified() &&
        hasPermission('manageSettings');

      allow update: if isSignedIn() &&
        isValidId(settingId) &&
        settingId == 'system' &&
        isValidSystemSettings(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isVerified() &&
        hasPermission('manageSettings') &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'organizationName', 'complexSubtitle', 'workStartHour', 'workEndHour',
          'maxAdvanceDays', 'requireAdminApproval', 'allowWeekendBookings',
          'strictAccountAccess', 'reportHeaderTitle', 'reportFooterNote',
          'lastBackupAt', 'lastBackupBy', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // --- Collection: Immutable Audit Logs ---
    match /auditLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isVerified() && !isSuspendedAccount() && (
        isAdmin() ||
        existing().actorUid == request.auth.uid ||
        existing().entityType in ['booking', 'classroom', 'department']
      );
      allow list: if (isGoogleVerifiedEmail() || (isPasswordProvider() && hasAccountEmailToken())) && (
        isBootstrappedAdmin() ||
        resource.data.actorUid == request.auth.uid ||
        resource.data.entityType in ['booking', 'classroom', 'department']
      );

      allow create: if isSignedIn() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().id == logId &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        canWriteAuditLogGate();

      allow update: if false;
      allow delete: if false;
    }
  }
}
